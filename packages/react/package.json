  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^21.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "@monorise/base": "^4.4.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "files": [
    "dist"
