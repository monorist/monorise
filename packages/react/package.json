{
  "name": "@monorise/react",
  "version": "8.3.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monorist/monorise.git",
    "directory": "packages/react"
  },
  "description": "Monorise React SDK — type-safe hooks, stores, and client utilities for entity and mutual data",
  "type": "module",
  "main": "dist/index.js",
