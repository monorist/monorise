      "types": "./dist/index.d.ts"
    }
  },
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist || true",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tabler/icons-react": "^3.30.0",
    "axios": "^1.8.1",
